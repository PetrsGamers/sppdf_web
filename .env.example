# Postgres connection string. Local DB: `docker compose up -d` (see docker-compose.yml).
# Never point this at the production database: dev pushes schema changes and the build runs migrations.
DATABASE_URL=postgres://postgres@127.0.0.1:54320/sppdf

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Google API key with the Calendar API enabled. Used by the syncGoogleCalendar job
# to read the public calendar sppdfmuni@gmail.com (calendar must be public).
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Optional: import public events from the association's Facebook Page (importFacebookEvents job).
# A never-expiring Page access token with pages_read_engagement; see README "Facebook events import".
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=

# Optional: set this in hosting if your platform has no deployment ID env.
# On Coolify, SOURCE_COMMIT is preferred (fallback: COOLIFY_CONTAINER_NAME / HOSTNAME).
# Change per deployment to trigger one-time calendar sync on boot.
# DEPLOYMENT_ID=deploy-001

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
